# Google Gemini API Key (Required for generating embeddings)
GEMINI_API_KEY=your_actual_gemini_api_key_here

# PostgreSQL Database Connection String (Get this from your Neon Dashboard)
POSTGRES_URL=postgresql://neondb_owner:your_password@your-endpoint-id.us-east-2.aws.neon.tech/neondb?sslmode=require
